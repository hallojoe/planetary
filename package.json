{
  "name": "planetary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A WebGL solar system observatory built with TypeScript and Vite",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "dev": "vite",
